{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["pip-compile"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Look up Python packages on the Lightwell indexes",
      "matchDatasources": ["pypi"],
      "registryUrls": [
        "https://packages.redhat.com/lightwell/python/validated/simple",
        "https://packages.redhat.com/lightwell/python/remediated/simple"
      ]
    }
  ]
}
